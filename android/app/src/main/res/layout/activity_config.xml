<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="28dp">

        <!-- ============ MINER ============ -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical">
            <TextView android:id="@+id/sectionMiner" style="@style/SectionHeader"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:text="MINER" />
            <ImageView android:id="@+id/infoMiner" style="@style/SectionInfo"
                android:contentDescription="Help: miner settings" />
        </LinearLayout>

        <TextView style="@style/FieldLabel"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="ALGORITHM" />
        <Spinner android:id="@+id/algoSpinner"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/field_bg"
            android:minHeight="52dp"
            android:paddingHorizontal="10dp" />

        <TextView style="@style/FieldLabel"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="THREADS" />
        <EditText android:id="@+id/threadsField" style="@style/FieldInput"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:inputType="number" android:text="4" />
        <TextView android:id="@+id/threadsHint"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_marginStart="2dp"
            android:text=""
            android:textColor="@color/textdim"
            android:textSize="12sp" />

        <!-- ============ POOLS ============ -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center_vertical">
            <TextView android:id="@+id/sectionPools" style="@style/SectionHeader"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:text="POOLS" />
            <ImageView android:id="@+id/infoPools" style="@style/SectionInfo"
                android:contentDescription="Help: pool settings" />
        </LinearLayout>
        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="The first pool is primary. Extra pools are failovers, tried in order when the pool above them is unreachable."
            android:textColor="@color/textdim"
            android:textSize="12sp" />

        <!-- Pool cards are inflated from pool_card.xml at runtime. -->
        <LinearLayout android:id="@+id/poolContainer"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView android:id="@+id/addPoolButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/field_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="48dp"
            android:text="+  ADD FAILOVER POOL"
            android:textColor="@color/accent"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.04" />

        <!-- ============ MONITORING ============ -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center_vertical">
            <TextView android:id="@+id/sectionMonitoring" style="@style/SectionHeader"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:text="MONITORING" />
            <ImageView android:id="@+id/infoMonitoring" style="@style/SectionInfo"
                android:contentDescription="Help: monitoring settings" />
        </LinearLayout>

        <CheckBox android:id="@+id/lanApiCheck"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Allow network monitoring"
            android:textColor="@color/text"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginStart="2dp"
            android:text="Expose the read-only status API (port 4068) to other devices on your wifi. Off = this phone only."
            android:textColor="@color/textdim"
            android:textSize="12sp" />

        <Button android:id="@+id/saveButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="30dp"
            android:background="@drawable/pill_bg"
            android:backgroundTint="@color/accent"
            android:text="@string/save"
            android:textColor="#120A21"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
