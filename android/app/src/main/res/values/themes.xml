<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="GhulehDark" parent="@android:style/Theme.Material">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:colorPrimary">@color/bar</item>
        <item name="android:colorPrimaryDark">@color/bg</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/textdim</item>
        <item name="android:alertDialogTheme">@style/GhulehDialog</item>
    </style>

    <!-- The ⓘ help popups. Stock AlertDialog otherwise inherits the device's
         default (light on OneUI/Samsung) dialog theme and clashes with the
         dark app; this pins it to the app palette. Framework-only, no lib. -->
    <style name="GhulehDialog" parent="@android:style/Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_bg</item>
        <item name="android:colorBackground">@color/card</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/textdim</item>
        <item name="android:colorAccent">@color/accent</item>
    </style>

    <style name="StatValue">
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="StatLabel">
        <item name="android:textColor">@color/textdim</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:layout_marginTop">3dp</item>
    </style>

    <!-- Config form -->
    <style name="SectionHeader">
        <item name="android:textColor">@color/accent</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:layout_marginTop">28dp</item>
    </style>

    <!-- The little ⓘ next to a section header; padding makes the touch target
         comfortable while the glyph itself stays 18dp. -->
    <style name="SectionInfo">
        <item name="android:src">@drawable/ic_info</item>
        <item name="android:layout_width">36dp</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:padding">9dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:background">?android:attr/selectableItemBackgroundBorderless</item>
    </style>

    <style name="FieldLabel">
        <item name="android:textColor">@color/textdim</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.03</item>
        <item name="android:layout_marginTop">18dp</item>
        <item name="android:layout_marginBottom">7dp</item>
    </style>

    <style name="FieldInput">
        <item name="android:background">@drawable/field_bg</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textColorHint">@color/textdim</item>
        <item name="android:textSize">16sp</item>
        <item name="android:paddingHorizontal">14dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:gravity">center_vertical</item>
    </style>
</resources>
