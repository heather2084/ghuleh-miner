# Build outputs
*.o
*.d
/build/
/primo-arm-miner
/third_party/RandomX/build/

# Android APK build outputs + staged native binary (do not commit binaries)
/android/build/
/android/app/src/main/jniLibs/arm64-v8a/*.so

# Local miner config (contains wallet/worker credentials; see CONFIG_EXAMPLES.md)
/config.json

# Release signing key material -- NEVER commit. This must live only on the
# device that builds releases (and in your own secure backup), never in git.
*.jks
*.keystore
keystore.properties

# Local development files (not part of the public tree)
/CLAUDE.md
/docs/
/tests/dev/
/test_*.sh
/snapshots/
/.claude/
/.codex/
/.vscode/
/Makefile.termux-orig
/.clang16-wrappers/
